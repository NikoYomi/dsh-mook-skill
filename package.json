{
  "name": "@yoursc/dsh-mook-skill",
  "version": "1.0.0",
  "description": "Mook 插件（DeepSeek Harness）：把 Mook 托管的服务器与常用命令交给 Agent 管理，含 14 个宿主工具、内嵌技能与 Web 设置页。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "locale",
    "lib",
    "skills",
    "test",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/harness.mjs",
    "check": "node --check lib/index.js && node --check lib/tools.js && node --check lib/client.js"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.5-rc.1 || >=0.1.6-0 || >=0.1.7-0"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dshhub": {
    "schemaVersion": 1,
    "displayName": "Mook",
    "summary": "把 Mook 接入 DeepSeek Harness：装一个插件就同时得到 14 个 mook_* 工具、内嵌技能与设置页。地址与密钥在设置页填（密钥存宿主凭据库，不回显），工具可逐个开关。",
    "categories": [
      "运维",
      "Web UI"
    ],
    "surfaces": [
      "host",
      "web"
    ],
    "capabilities": {
      "provides": [
        "service:mook"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.5-rc.1 || >=0.1.6-0 || >=0.1.7-0",
      "node": ">=20"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mook",
    "ssh",
    "vps",
    "web"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/NikoYomi/dsh-mook-skill.git"
  }
}
